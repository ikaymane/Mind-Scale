# Copy to .env (never commit .env). All optional: without an LLM key the agent answers with rule-based templates.

# Any OpenAI-compatible chat API. DeepSeek:
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=

# Where confirmed fire alerts are POSTed (JSON). Empty = console only.
# For the demo, a https://webhook.site URL shows each alert arriving.
ALERT_WEBHOOK_URL=

# Minutes between two reads of NASA FIRMS
WATCH_INTERVAL_MIN=10

# api.nasa.gov key (not needed by the current sources)
NASA_API_KEY=
